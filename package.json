{
  "name": "plugin-de-orquestacion-para-opencode",
  "version": "0.9.0",
  "description": "Plugin de orquestación de agentes y subagentes para OpenCode (arquitectura Aiapaec)",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "lint": "biome lint src scripts",
    "typecheck": "tsc --noEmit",
    "agents:sync": "esbuild scripts/sync-agents.ts --bundle --platform=node --format=esm --outfile=.tmp/sync-agents.mjs --log-level=error && node .tmp/sync-agents.mjs",
    "agents:install": "esbuild scripts/sync-agents.ts --bundle --platform=node --format=esm --outfile=.tmp/sync-agents.mjs --log-level=error && node .tmp/sync-agents.mjs --install",
    "agents:check": "esbuild scripts/check-agents.ts --bundle --platform=node --format=esm --outfile=.tmp/check-agents.mjs --log-level=error && node .tmp/check-agents.mjs",
    "cierre": "node scripts/cierre.mjs",
    "skills:lock": "node scripts/skills-lock.mjs",
    "dashboard": "node scripts/abrir-dashboard.mjs",
    "test": "pnpm run lint && pnpm run typecheck && esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.tmp/smoke.mjs --log-level=error && node --test .tmp/smoke.mjs"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ysrael-rojas/plugin_orquestacion.git"
  },
  "keywords": [
    "opencode",
    "plugin",
    "orchestration",
    "agents",
    "subagents",
    "worktrees"
  ]
}
